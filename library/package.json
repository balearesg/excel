{
	"name": "excel",
	"version": "0.0.1",
	"title": "excel",
	"scope": "bggroup",
	"description": "package for excel handlig",
	"license": "ISC",
	"modules": {
		"path": "modules"
	},
	"deployment": {
		"distributions": [
			{
				"name": "web",
				"environment": "development",
				"platform": "web",
				"ports": {
					"bundles": 3600
				}
			},
			{
				"name": "node",
				"environment": "development",
				"platform": "node",
				"ports": {
					"bundles": 9871,
					"http": 9872,
					"inspect": 9873
				}
			},
			{
				"name": "node-tsc",
				"environment": "development",
				"platform": "node",
				"ts": {
					"compiler": "tsc"
				},
				"ports": {
					"bundles": 9874
				}
			}
		]
	},
	"dependencies": {
		"@beyond-js/kernel": "~0.1.14",
		"csv-parser": "^3.0.0",
		"exceljs": "^4.4.0",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@beyond-js/local": "~0.1.3"
	}
}
